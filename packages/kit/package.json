{
  "name": "symmetria-kit",
  "version": "1.0.1",
  "description": "PostgreSQL migrations, schema browser and live query profiler for Node.js and Bun.",
  "homepage": "https://github.com/nokturnal3301/symmetria#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nokturnal3301/symmetria.git",
    "directory": "packages/kit"
  },
  "bugs": {
    "url": "https://github.com/nokturnal3301/symmetria/issues"
  },
  "type": "module",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./inspect": {
      "types": "./dist/cli/query-inspect.d.ts",
      "default": "./dist/cli/query-inspect.js"
    },
    "./testing": {
      "types": "./dist/testing.d.ts",
      "default": "./dist/testing.js"
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "symmetria": "./dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "bun run --cwd ../.. build:kit",
    "prepack": "bun run build"
  },
  "peerDependencies": {
    "symmetria": "1.0.1"
  },
  "dependencies": {
    "pg": "^8.23.1",
    "string-width": "^8.1.0"
  },
  "engines": {
    "node": ">=24.11.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "symmetria",
    "postgres",
    "migrations",
    "bun",
    "cli"
  ],
  "author": "Mikhail Demidoff <demidoff.mikhail@gmail.com>",
  "license": "MIT"
}
