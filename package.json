{
  "name": "symmetria-workspace",
  "private": true,
  "version": "0.2.0",
  "description": "Type-safe, SQL-first PostgreSQL query builder for Bun, with an embedded SQLite driver.",
  "homepage": "https://github.com/nokturnal3301/symmetria#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nokturnal3301/symmetria.git"
  },
  "bugs": {
    "url": "https://github.com/nokturnal3301/symmetria/issues"
  },
  "type": "module",
  "packageManager": "bun@1.4.4",
  "workspaces": [
    "packages/*"
  ],
  "keywords": [
    "postgres",
    "postgresql",
    "sql",
    "query-builder",
    "orm",
    "typesafe",
    "typescript",
    "bun",
    "migrations",
    "functional"
  ],
  "scripts": {
    "test": "bun run test:unit && bun run test:cli && bun run test:types",
    "test:unit": "bun test tests/runtime/unit tests/kit/unit",
    "test:cli": "bun test tests/kit/cli",
    "test:types": "tsc -p tests/tsconfig.json",
    "test:integration": "bun tests/support/run-postgres.ts",
    "typecheck": "tsc --noEmit",
    "build": "tsdown",
    "build:runtime": "tsdown --filter symmetria",
    "build:kit": "bun run build:runtime && tsdown --filter symmetria-kit",
    "build:watch": "tsdown --watch",
    "pack": "bun run build && mkdir -p .build/packages && npm pack ./packages/runtime ./packages/kit --ignore-scripts --pack-destination .build/packages",
    "lint": "eslint .",
    "format": "eslint . --fix && biome format --write && prettier --write \"**/*.{md,yml,yaml}\"",
    "format:check": "bun run lint && biome format && prettier --check \"**/*.{md,yml,yaml}\"",
    "check": "bun run format:check && bun run typecheck",
    "check:release": "bun run check && bun run test && bun run test:integration && bun run test:packages && bun run test:examples",
    "test:packages": "bun tests/packages/installed.ts",
    "test:examples": "bun tests/examples/run.ts"
  },
  "author": "Mikhail Demidoff <demidoff.mikhail@gmail.com>",
  "license": "MIT",
  "engines": {
    "bun": ">=1.4.4",
    "node": ">=24.11.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@symmetria/style": "workspace:*",
    "@types/bun": "^1.4.3",
    "eslint": "^10.13.0",
    "prettier": "3.9.10",
    "publint": "^0.3.25",
    "symmetria": "workspace:*",
    "symmetria-kit": "workspace:*",
    "tsdown": "^0.23.1",
    "typescript": "^7.0.2"
  }
}
