{
  "name": "symmetria-benchmarks",
  "private": true,
  "type": "module",
  "scripts": {
    "check": "tsc -p tsconfig.json && bun test ./src/harness",
    "generate": "bun node_modules/prisma/build/index.js generate --config fixtures/prisma.config.ts",
    "docker": "bun src/docker.ts",
    "report": "bun src/report.ts",
    "publish": "bun src/publish.ts",
    "micro": "bun src/diagnostics/micro.ts"
  },
  "dependencies": {
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "drizzle-orm": "0.45.4",
    "kysely": "0.29.7",
    "pg": "8.23.1",
    "prisma": "7.10.1",
    "string-width": "8.1.0"
  },
  "devDependencies": {
    "@types/pg": "8.23.1",
    "@types/bun": "1.4.3",
    "typescript": "7.0.2"
  }
}
